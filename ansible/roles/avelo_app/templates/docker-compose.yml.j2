# Rendered by the avelo_app role. Images are built+pushed by the app repo CI.
# Schema is baked into the poller image; dashboards into the grafana image —
# so there are no host-side config files, only this compose and .env.
services:
  timescaledb:
    image: timescale/timescaledb:2.17.2-pg16
    environment:
      POSTGRES_USER: {{ avelo_postgres_user }}
      POSTGRES_PASSWORD: ${PGPASSWORD}
      POSTGRES_DB: {{ avelo_postgres_db }}
    volumes:
      - tsdb_data:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ avelo_postgres_user }}"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped
  poller:
    image: {{ avelo_registry }}/avelo-poller:{{ avelo_image_tag }}
    depends_on:
      timescaledb: {condition: service_healthy}
    environment:
      DATABASE_URL: postgresql://{{ avelo_postgres_user }}:${PGPASSWORD}@timescaledb:5432/{{ avelo_postgres_db }}
      APPLY_SCHEMA: "1"
      POLL_INTERVAL_SECONDS: "{{ avelo_poll_interval_seconds }}"
    restart: unless-stopped
  inference:
    image: {{ avelo_registry }}/avelo-inference:{{ avelo_image_tag }}
    depends_on:
      timescaledb: {condition: service_healthy}
    environment:
      DATABASE_URL: postgresql://{{ avelo_postgres_user }}:${PGPASSWORD}@timescaledb:5432/{{ avelo_postgres_db }}
      INFER_INTERVAL_SECONDS: "{{ avelo_infer_interval_seconds }}"
      INFER_SYSTEMS: "{{ avelo_infer_systems }}"
    restart: unless-stopped
  grafana:
    image: {{ avelo_registry }}/avelo-grafana:{{ avelo_image_tag }}
    depends_on: [timescaledb]
    # STAGE 2 fix (August 2026): a fresh named volume mounted at a path
    # never referenced by the base image's own setup (unlike the default
    # /var/lib/grafana, which the image's entrypoint chowns to the grafana
    # user at container start) is owned by root when Docker creates it.
    # Grafana's container runs as a non-root user by default and cannot
    # write to a root-owned path — confirmed directly: "permission denied"
    # creating grafana.db under /var/lib/grafana-persist on first deploy of
    # this stage. Running as root (uid 0) for this container sidesteps
    # that ownership mismatch entirely. This is the documented workaround
    # for custom Grafana data paths (see Grafana's own Docker install docs,
    # "file permissions" section) — an alternative fixed-uid approach
    # (matching the image's built-in grafana user, typically uid 472)
    # was considered and rejected here because that uid isn't guaranteed
    # stable across Grafana image versions, whereas root always has
    # write access regardless.
    user: "0"
    environment:
      GF_SECURITY_ADMIN_PASSWORD: ${GF_ADMIN_PASSWORD}
      GF_PATHS_DATA: /var/lib/grafana-persist
      PGUSER: {{ avelo_postgres_user }}
      PGPASSWORD: ${PGPASSWORD}
      PGDATABASE: {{ avelo_postgres_db }}
    volumes: [grafana_data:/var/lib/grafana-persist]
    ports: ["{{ avelo_grafana_port }}:3000"]
    restart: unless-stopped
volumes:
  tsdb_data:
  grafana_data: